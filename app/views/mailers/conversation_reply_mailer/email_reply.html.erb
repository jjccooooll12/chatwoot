<% if @message.content_attributes.dig('email', 'html_content', 'reply').present? %>
<%= @message.content_attributes.dig('email', 'html_content', 'reply').html_safe %>
<% elsif @message.content %>
<%= @message.outgoing_content.html_safe %>
<% end %>
<% if @large_attachments.present? %>
<p>Attachments:</p>
<% @large_attachments.each do |attachment| %>
<p><a href="<%= attachment.file_url %>" target="_blank"><%= attachment.file.filename.to_s %></a></p>
<% end %>
<% end %>
<% if (quoted = previous_quotable_message) %>
<blockquote type="cite" style="margin: 1em 0 0 0; padding-left: 1em; border-left: 2px solid #d0d0d0; color: #5f5f5f;">
<p style="margin: 0 0 0.5em 0; font-family: Roboto, 'Helvetica Neue', Tahoma, Arial, sans-serif;">On <%= quoted.created_at.strftime('%a, %b %-d, %Y at %-I:%M %p') %>, <%= quoted_sender_label(quoted) %> wrote:</p>
<% if quoted.content_attributes.dig('email', 'html_content', 'full').present? %>
<%= quoted.content_attributes.dig('email', 'html_content', 'full').html_safe %>
<% elsif quoted.content %>
<%= ChatwootMarkdownRenderer.new(quoted.content).render_message %>
<% end %>
</blockquote>
<% end %>
